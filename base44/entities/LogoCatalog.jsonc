{
  "name": "LogoCatalog",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre del logo (ej: Logo Empresa X)"
    },
    "cliente": {
      "type": "string",
      "description": "Cliente principal (legado; primer cliente asignado)"
    },
    "clientes": {
      "type": "array",
      "description": "Clientes/empresas a los que pertenece este logo (multi-asignacion)",
      "items": {
        "type": "string"
      }
    },
    "imagen_url": {
      "type": "string",
      "description": "URL de la imagen del logo"
    },
    "archivo_wilcom_url": {
      "type": "string",
      "description": "URL del primer archivo de bordado (legado, primer elemento de archivos_wilcom)"
    },
    "archivo_wilcom_nombre": {
      "type": "string",
      "description": "Nombre original del primer archivo Wilcom (legado)"
    },
    "archivos_wilcom": {
      "type": "array",
      "description": "Archivos de bordado (Wilcom .emb/.dst/.pes, etc.) asociados al logo",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          }
        }
      }
    },
    "archivos_vector": {
      "type": "array",
      "description": "Archivos vectoriales (Corel/Illustrator/Photoshop/Affinity) asociados al logo",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "software": {
            "type": "string"
          }
        }
      }
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n del logo / instrucciones"
    },
    "costo": {
      "type": "number",
      "description": "Costo base del logo"
    },
    "iva": {
      "type": "number",
      "description": "Tasa de IVA (0, 0.08, 0.16)"
    },
    "puntadas": {
      "type": "number",
      "description": "N\u00famero de puntadas del bordado"
    },
    "alto_cm": {
      "type": "number",
      "description": "Alto en cm"
    },
    "ancho_cm": {
      "type": "number",
      "description": "Ancho en cm"
    },
    "color_hilos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "C\u00f3digos de colores de hilo"
    },
    "bobina_negra": {
      "type": "boolean"
    },
    "bobina_blanca": {
      "type": "boolean"
    },
    "vinil_codigo": {
      "type": "string",
      "description": "C\u00f3digo de vinil textil"
    },
    "extras": {
      "type": "object",
      "properties": {
        "foamy": {
          "type": "boolean"
        },
        "velcro_macho": {
          "type": "boolean"
        },
        "velcro_hembra": {
          "type": "boolean"
        },
        "adhesivo_termico": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "nombre"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}